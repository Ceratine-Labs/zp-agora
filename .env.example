APP_NAME="Agora"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Real SMTP, or nobody can set a password. Every user migrated out of PumpIT
# arrives with an unusable one, and the mailed link is the only way in — with
# MAIL_MAILER=log that link is written to storage/logs/laravel.log and sent to
# nobody, which looks exactly like a working system until somebody tries.
# Credentials are the Ceratine bulkmail-za account, shared with ZP-NQL.
MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=mail.bulkmail-za.com
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="no-reply@ceratine-labs.co.za"
MAIL_FROM_NAME="Agora"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# Customer databases — one SQL Server 2017 instance, one login ().
# `pumpit` is the default connection: Agora's own objects live in its `agora`
# schema. encrypt + trust_server_certificate are both required (ODBC 18
# ---------------------------------------------------------------------------
# Agora's own database — the DEFAULT connection
# ---------------------------------------------------------------------------
# The only database Agora writes to. On ZP it sits on the same instance as
# PumpIT; locally it is the `agora-sql` Docker container (see docs/local-sql.md).
#
# It MUST be created with COLLATE Latin1_General_CI_AS to match PumpIT —
# a different collation makes every cross-database string comparison throw
# "Cannot resolve collation conflict".
AGORA_DB_HOST=127.0.0.1
AGORA_DB_PORT=1433
AGORA_DB_DATABASE=Agora
AGORA_DB_USERNAME=sa
AGORA_DB_PASSWORD=
AGORA_DB_ENCRYPT=yes
AGORA_DB_TRUST_SERVER_CERTIFICATE=true

# validates by default; the instance's certs are self-signed).
# ---------------------------------------------------------------------------
DB_CONNECTION=agora

PUMPIT_DB_HOST=
PUMPIT_DB_PORT=1433
PUMPIT_DB_DATABASE=PumpIT
PUMPIT_DB_USERNAME=
PUMPIT_DB_PASSWORD=
PUMPIT_DB_ENCRYPT=yes
PUMPIT_DB_TRUST_SERVER_CERTIFICATE=true

MIST_DB_HOST=
MIST_DB_PORT=1433
MIST_DB_DATABASE=MIST_Import
MIST_DB_USERNAME=
MIST_DB_PASSWORD=
MIST_DB_ENCRYPT=yes
MIST_DB_TRUST_SERVER_CERTIFICATE=true

ALTERYX_DB_HOST=
ALTERYX_DB_PORT=1433
ALTERYX_DB_DATABASE=Alteryx
ALTERYX_DB_USERNAME=
ALTERYX_DB_PASSWORD=
ALTERYX_DB_ENCRYPT=yes
ALTERYX_DB_TRUST_SERVER_CERTIFICATE=true

# The group entity's branch id (Zululand Petroleum, dbo.SS_Branch.SSBranchId=2).
# Rows that are not branch-specific carry this rather than NULL — a NULL branch
# is how legacy rows became unreportable.
AGORA_GROUP_BRANCH_ID=2

# ---------------------------------------------------------------------------
# End-to-end tests
#
# A dedicated, read-only (auditor) account for Playwright, so no suite ever
# signs in as a real person. The seeder that creates it refuses to run when
# APP_ENV=production. Leave AGORA_E2E_PASSWORD unset and the seeder skips and
# the specs skip with it, rather than failing.
# ---------------------------------------------------------------------------
AGORA_E2E_EMAIL=TEST-playwright@agora.local
AGORA_E2E_PASSWORD=
AGORA_E2E_BRANCH_ID=999
AGORA_BASE_URL=http://127.0.0.1:8123
# ---------------------------------------------------------------------------
# Cross-app single sign-on (config/sso.php)
#
# ZP-NQL and Agora share a box and, from 2026-09-09, a sign-in: a session in
# either signs you into the other, and signing out of either ends both.
#
# OFF unless SSO_ENABLED is true AND a secret AND a peer URL are all set —
# any one missing and the app behaves exactly as it did before.
#
# SSO_SHARED_SECRET must be BYTE-IDENTICAL in both apps. Generate once with
#   php -r "echo base64_encode(random_bytes(32)).PHP_EOL;"
# and paste the same value into both .env files.
#
# The audiences must be MIRRORED: this app's SSO_AUDIENCE is the other's
# SSO_PEER_AUDIENCE and vice versa. That pairing is what stops a ticket
# minted for one app being replayed against the other.
#
# SSO_COOKIE_DOMAIN is the parent domain both hosts share, so one app's
# "nobody is signed in" answer settles the question for both. Leave it unset
# in local development, where both apps are on 127.0.0.1 already.
SSO_ENABLED=false
SSO_SHARED_SECRET=
SSO_AUDIENCE=agora
SSO_PEER_AUDIENCE=zp-nql
SSO_PEER_URL=https://zp-db.ceratine.com
SSO_PEER_NAME=ZP-NQL
SSO_COOKIE_DOMAIN=
SSO_TICKET_TTL=30
SSO_LOOPGUARD_MINUTES=10
